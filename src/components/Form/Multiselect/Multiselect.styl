// Overwrite default react-select styles

.react-multiselect
  .rms__control
    min-height 46px

  .rms__control--is-focused
    border-color #66afe9
    box-shadow inset 0 1px 1px rgba(0,0,0,0.075), 0 0 8px rgba(102,175,233,0.6)

  .rms__multi-value
    margin 9px 0 9px 10px
    color currentColor
    border none
    background-color rgba(black, 0.05)
    line-height 2

  .rms__multi-value__label
    padding-left 10px
    padding-right 10px
    font-size 12px

  .rms__multi-value__remove
    border-left 1px solid rgba(black, 0.1)
    border-radius 0

    &:hover
      color black
      background-color rgba(black, 0.1)

  .rms__value-container
    padding-top 0
    padding-bottom 0

// Options rendered inside the virtualized list keep a fixed height
.react-multiselect-virtualized
  .rms__option
    height 100%
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
