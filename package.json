{
  "name": "auth0-extension-ui",
  "version": "2.0.0",
  "description": "Auth0 Extension UI",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "*.styl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auth0-extensions/auth0-extension-ui.git"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && cross-env NODE_ENV=production webpack --config webpack.config.js",
    "build-dev": "npm run clean && cross-env NODE_ENV=development webpack --config webpack.config.js",
    "prepare": "npm run build",
    "release": "npm test && git tag $npm_package_version && git push && git push --tags && npm publish",
    "lint": "eslint src",
    "lintfix": "eslint src --fix",
    "test": "mocha",
    "test-watch": "mocha --watch",
    "storybook": "storybook dev -p 9010",
    "build-storybook": "storybook build -o .out",
    "publish-storybook": "bash .scripts/publish_storybook.sh"
  },
  "keywords": [
    "auth0"
  ],
  "author": "auth0",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@babel/register": "^8.0.6",
    "@cfaester/enzyme-adapter-react-18": "^0.8.0",
    "@eslint/js": "^9.39.5",
    "@storybook/react-webpack5": "^10.6.0",
    "@types/node": "22.20.4",
    "babel-loader": "^10.1.1",
    "chai": "^6.2.2",
    "classnames": "^2.5.1",
    "codemirror": "^5.65.21",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "enzyme": "^3.11.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "git-url-parse": "^16.1.0",
    "globals": "^17.12.0",
    "ignore-styles": "^5.0.1",
    "jsdom": "^30.1.0",
    "mocha": "^12.0.2",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.3.1",
    "react-dropzone": "^20.1.2",
    "react-redux": "^8.1.3",
    "react-router": "^7.18.4",
    "react-select": "^5.10.2",
    "react-window": "^2.3.1",
    "redux": "^4.2.1",
    "redux-form": "^8.3.10",
    "rimraf": "^6.1.3",
    "sinon": "^22.1.0",
    "storybook": "^10.6.0",
    "style-loader": "^4.0.0",
    "stylus": "^0.64.0",
    "stylus-loader": "^9.0.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12"
  },
  "allowScripts": {
    "esbuild": true
  }
}
